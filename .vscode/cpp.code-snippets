  "Class with Rule of 5 (class2)": {
    "prefix": "class2",
    "description": "Фрагмент кода для класса (Rule of 5)",
    "body": [
      "class ${1:MyClass}",
      "{",
      "public:",
      "    $1();",
      "    ~$1() = default;",
      "    $1(const $1& name);",
      "    $1& operator=(const $1& name);",
      "    $1($1&& name);",
      "    $1& operator=($1&& name);",
      "",
      "private:",
      "    ${TM_SELECTED_TEXT}$0",
      "};",
      "",
      "$1::$1()",
      "{",
      "}",
      "",
      "$1::$1(const $1& name)",
      "{",
      "}",
      "",
      "$1& $1::operator=(const $1& name)",
      "{",
      "    if (&name == this) return *this;",
      "    temp(name);",
      "    swap(name);",
      "    return *this;",
      "}",
      "",
      "$1::$1($1&& name)",
      "{",
      "}",
      "",
      "$1& $1::operator=($1&& name)",
      "{",
      "    if (&name == this) return *this;",
      "    // ...moving object",
      "    return *this;",
      "}"
    ]
  },

